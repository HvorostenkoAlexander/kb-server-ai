																							}
																							],"default":null
																	},
																	{"name":"mismatch", "type":"int", "doc":"Результаты проверки параметра 0 - не соответствует 1 - соответствует 2 - аттестация не требуется, справочное значение 3 - нет результатов испытаний, но аттестация требуется 4 - не соответствует, но есть рекомендации по устранению не соответствия 5 - соответствует, изменено сотрудником УАИП"},
																	{"name":"note", "type":["null","string"],"doc":"Пояснение результата проверки характеристики","default":null},
