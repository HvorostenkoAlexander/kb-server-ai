{"namespace":"nlmk.l3.apcs",
"type":"record",
"doc":"Передача результатов аттестации APCS",
"name":"VerificationResults",
"fields":
	[ 
		{"name":"ts","type":"string","doc":"Дата и время передачи данных в формате YYYY-MM-DDThh:mm:ss[.SSS]±hh:mm)"},
		{"name":"op","type":{"type":"enum","name":"EnumOp","symbols":["I","U"]},"doc":"Операция (I, U)"},
