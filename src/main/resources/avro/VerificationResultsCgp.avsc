{
  "type": "record",
  "name": "VerificationResultsCgp",
  "namespace": "nlmk.apcs.verification.results.cgp.v0",
  "doc": "Передача результатов аттестации APCS. Version: [1]",
  "fields": [
    {
      "name": "ts",
      "type": {
        "type": "string",
        "avro.java.string": "String"
      },
      "doc": "Дата и время передачи данных в формате YYYY-MM-DDThh:mm:ss[.SSS]±hh:mm)"
    },
    {
      "name": "op",
      "type": {
        "type": "enum",
        "name": "EnumOp",
        "symbols": [
          "I",
          "U"
        ]
      },
      "doc": "Операция (I, U)"
    },
    {
      "name": "pk",
      "type": {
        "type": "record",
        "name": "RecordPk",
        "fields": [
          {
            "name": "id",
            "type": "long",
            "doc": "ИД результата аттестации"
          }
        ]
      }
    },
    {
      "name": "sys",
      "type": [
        "null",
        {
          "type": "record",
          "name": "RecordSys",
          "fields": [
            {
              "name": "seqID",
              "type": "long",
              "doc": "Монотонно возрастающий счетчик для проверки или восстановления оригинальной последовательности",
              "default": -1
            },
            {
              "name": "traceID",
              "type": {
                "type": "string",
                "avro.java.string": "String"
              },
              "doc": "Сквозной Trace ID (обычно UUID)",
              "default": ""
            }
          ]
        }
      ],
      "doc": "Системные поля, заполняемые источником",
      "default": null
    },
    {
      "name": "metadata",
      "type": [
        "null",
        {
          "type": "record",
          "name": "RecordMetadata",
          "fields": [
            {
              "name": "kafkaKeySchemaID",
              "type": "int",
              "doc": "Версия схемы ключа",
              "default": -1
            },
            {
              "name": "kafkaValueSchemaID",
              "type": "int",
              "doc": "Версия схемы значения",
              "default": -1
            },
            {
              "name": "kafkaKey",
              "type": {
                "type": "string",
                "avro.java.string": "String"
              },
              "doc": "Ключ в Kafka",
              "default": ""
            },
            {
              "name": "kafkaPartition",
              "type": "int",
              "doc": "Номер партиции",
              "default": -1
            },
            {
              "name": "kafkaOffset",
              "type": "long",
              "doc": "Offset в Kafka",
              "default": -1
            },
            {
              "name": "kafkaTimestamp",
              "type": {
                "type": "string",
                "avro.java.string": "String"
              },
              "doc": "Время сообщения в Kafka",
              "default": ""
            },
            {
              "name": "kafkaTopic",
              "type": {
                "type": "string",
                "avro.java.string": "String"
              },
              "doc": "Имя топика",
              "default": ""
            },
            {
              "name": "kafkaHeaders",
              "type": [
                "null",
                {
                  "type": "map",
                  "values": {
                    "type": "string",
                    "avro.java.string": "String"
                  },
                  "avro.java.string": "String"
                }
              ],
              "doc": "kafkaHeaders",
              "default": null
            }
          ]
        }
      ],
      "doc": "Структура под метаданные Kafka, заполняется Подписчиком после чтения из Kafka",
      "default": null
    },
    {
      "name": "data",
      "type": {
        "type": "record",
        "name": "RecordData",
        "fields": [
          {
            "name": "workshopId",
            "type": [
              "null",
              {
                "type": "string",
                "avro.java.string": "String"
              }
            ],
            "doc": "Guid цеха"
          },
          {
            "name": "workshopName",
            "type": {
              "type": "string",
              "avro.java.string": "String"
            },
            "doc": "Наименование цеха"
          },
          {
            "name": "orderNum",
            "type": "long",
            "doc": "Номер заказа"
          },
          {
            "name": "orderPosition",
            "type": "int",
            "doc": "Номер позиции заказа"
          },
          {
            "name": "metalUnitId",
            "type": [
              "null",
              {
                "type": "string",
                "avro.java.string": "String"
              }
            ],
            "doc": "Идентификатор единицы складского учета"
          },
          {
            "name": "marking",
            "type": [
              "null",
              {
                "type": "array",
                "items": {
                  "type": "record",
                  "name": "RecordMarking",
                  "doc": "Маркировка единицы аттестации",
                  "fields": [
                    {
                      "name": "attrCode",
                      "type": "int",
                      "doc": "Код атрибута маркировки"
                    },
                    {
                      "name": "attrId",
                      "type": {
                        "type": "string",
                        "avro.java.string": "String"
                      },
                      "doc": "Guid атрибута маркировки"
                    },
                    {
                      "name": "attrName",
                      "type": {
                        "type": "string",
                        "avro.java.string": "String"
                      },
                      "doc": "Наименование атрибута маркировки"
                    },
                    {
                      "name": "dataTypePhysical",
                      "type": {
                        "type": "string",
                        "avro.java.string": "String"
                      },
                      "doc": "Константа обозначения физического типа AVRO"
                    },
                    {
                      "name": "value",
                      "type": {
                        "type": "string",
                        "avro.java.string": "String"
                      },
                      "doc": "Значение атрибута маркировки"
                    }
                  ]
                },
                "default": null
              }
            ]
          },
          {
            "name": "analyzes",
            "type": {
              "type": "array",
              "items": {
                "type": "record",
                "name": "RecordAnalyzes",
                "doc": "Массив групп качественных характеристик проведенных испытаний",
                "fields": [
                  {
                    "name": "groupId",
                    "type": {
                      "type": "string",
                      "avro.java.string": "String"
                    },
                    "doc": "Guid группы качественных характеристик"
                  },
                  {
                    "name": "groupName",
                    "type": {
                      "type": "string",
                      "avro.java.string": "String"
                    },
                    "doc": "Полное наименование группы качественных характеристик"
                  },
                  {
                    "name": "protNum",
                    "type": [
                      "null",
                      {
                        "type": "string",
                        "avro.java.string": "String"
                      }
                    ],
                    "doc": "Номер протокола",
                    "default": null
                  },
                  {
                    "name": "protDate",
                    "type": [
                      "null",
                      {
                        "type": "string",
                        "avro.java.string": "String"
                      }
                    ],
                    "doc": "Дата формирования протокола",
                    "default": null
                  },
                  {
                    "name": "testTypeRequestId",
                    "type": [
                      "null",
                      {
                        "type": "string",
                        "avro.java.string": "String"
                      }
                    ],
                    "doc": "Код типа запроса на испытания",
                    "default": null
                  },
                  {
                    "name": "qualityIndicators",
                    "type": {
                      "type": "array",
                      "items": {
                        "type": "record",
                        "name": "RecordQualityIndicators",
                        "doc": "Массив качественных характеристик проведенных испытаний",
                        "fields": [
                          {
                            "name": "attrId",
                            "type": {
                              "type": "string",
                              "avro.java.string": "String"
                            },
                            "doc": "Guid качественной характеристики"
                          },
                          {
                            "name": "attrCode",
                            "type": "int",
                            "doc": "Числовой код качественной характеристики"
                          },
                          {
                            "name": "attrName",
                            "type": {
                              "type": "string",
                              "avro.java.string": "String"
                            },
                            "doc": "Наименование качественной характеристики"
                          },
                          {
                            "name": "dataTypePhysical",
                            "type": {
                              "type": "string",
                              "avro.java.string": "String"
                            },
                            "doc": "Константа обозначения физического типа AVRO"
                          },
                          {
                            "name": "comparison",
                            "type": {
                              "type": "enum",
                              "name": "Comparison",
                              "doc": "Оператор сравнения",
                              "symbols": [
                                "EQUAL",
                                "MORE",
                                "LESS"
                              ]
                            }
                          },
                          {
                            "name": "value",
                            "type": {
                              "type": "string",
                              "avro.java.string": "String"
                            },
                            "doc": "Значение качественной характеристики"
                          },
                          {
                            "name": "measure",
                            "type": [
                              "null",
                              {
                                "type": "record",
                                "name": "RecordMeasure",
                                "fields": [
                                  {
                                    "name": "measureId",
                                    "type": {
                                      "type": "string",
                                      "avro.java.string": "String"
                                    },
                                    "doc": "Guid единицы измерения"
                                  },
                                  {
                                    "name": "measureName",
                                    "type": {
                                      "type": "string",
                                      "avro.java.string": "String"
                                    },
                                    "doc": "Наименование единицы измерения"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "name": "addProperties",
                            "type": [
                              "null",
                              {
                                "type": "array",
                                "items": {
                                  "type": "record",
                                  "name": "RecordAddProperties",
                                  "doc": "Дополнительные свойства характеристики",
                                  "fields": [
                                    {
                                      "name": "attrId",
                                      "type": {
                                        "type": "string",
                                        "avro.java.string": "String"
                                      },
                                      "doc": "Guid качественной характеристики"
                                    },
                                    {
                                      "name": "attrCode",
                                      "type": "int",
                                      "doc": "Числовой код качественной характеристики"
                                    },
                                    {
                                      "name": "attrName",
                                      "type": {
                                        "type": "string",
                                        "avro.java.string": "String"
                                      },
                                      "doc": "Наименование качественной характеристики"
                                    },
                                    {
                                      "name": "dataTypePhysical",
                                      "type": {
                                        "type": "string",
                                        "avro.java.string": "String"
                                      },
                                      "doc": "Константа обозначения физического типа AVRO"
                                    },
                                    {
                                      "name": "comparison",
                                      "type": "Comparison"
                                    },
                                    {
                                      "name": "value",
                                      "type": {
                                        "type": "string",
                                        "avro.java.string": "String"
                                      },
                                      "doc": "Значение качественной характеристики"
                                    },
                                    {
                                      "name": "measure",
                                      "type": [
                                        "null",
                                        "RecordMeasure"
                                      ]
                                    }
                                  ]
                                },
                                "default": null
                              }
                            ]
                          },
                          {
                            "name": "asapResponse",
                            "type": {
                              "type": "record",
                              "name": "AsapResponse",
                              "fields": [
                                {
                                  "name": "apcsAttestationResultId",
                                  "type": [
                                    "null",
                                    {
                                      "type": "string",
                                      "avro.java.string": "String"
                                    }
                                  ],
                                  "doc": "Код результата аттестации АСАП",
                                  "default": null
                                },
                                {
                                  "name": "apcsAttestationResultCode",
                                  "type": "int",
                                  "doc": "Код результата аттестации АСАП"
                                },
                                {
                                  "name": "note",
                                  "type": [
                                    "null",
                                    {
                                      "type": "string",
                                      "avro.java.string": "String"
                                    }
                                  ],
                                  "doc": "Источник допустимых значений показателей качества",
                                  "default": null
                                },
                                {
                                  "name": "norms",
                                  "type": {
                                    "type": "record",
                                    "name": "Norms",
                                    "fields": [
                                      {
                                        "name": "valueMin",
                                        "type": [
                                          "null",
                                          {
                                            "type": "string",
                                            "avro.java.string": "String"
                                          }
                                        ],
                                        "doc": "Минимально допустимое значение",
                                        "default": null
                                      },
                                      {
                                        "name": "valueMax",
                                        "type": [
                                          "null",
                                          {
                                            "type": "string",
                                            "avro.java.string": "String"
                                          }
                                        ],
                                        "doc": "Максимально допустимое значение",
                                        "default": null
                                      },
                                      {
                                        "name": "listAccValues",
                                        "type": [
                                          "null",
                                          {
                                            "type": "array",
                                            "items": {
                                              "type": "string",
                                              "avro.java.string": "String"
                                            }
                                          }
                                        ],
                                        "default": null
                                      }
                                    ]
                                  }
                                }
                              ]
                            }
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ]
}